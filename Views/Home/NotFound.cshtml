@{
    ViewData["Title"] = "Page Not Found";
}
<div class="container card my-5 px-4 pt-4 pb-3">
    <h1 class="text-center bg-dark-subtle rounded-2 py-2 mb-2">404 - Page Not Found</h1>
    <hr/>
    <p>Sorry, but the requested page: <span class="fw-bold">@ViewData["path"]</span> doesn’t exist.</p>
    <a href="/" class="btn btn-jade">Back to Home</a>
</div>
