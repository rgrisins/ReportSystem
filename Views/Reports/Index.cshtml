@model ReportSystem.Models.ReportStatusViewModel

@{
    ViewData["Title"] = "Index";
}

<div class="container card my-5 px-4 pt-4 pb-3">
    <h1 class="text-center bg-dark-subtle rounded-2 py-2 mb-1">REPORTS</h1>
    <hr />
    @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
    {
        <div>
            <a asp-action="Create" class="btn btn-cadet-blue w-100">Create New</a>
        </div>
    }
    <hr />
    <div class="d-flex flex-row flex-wrap align-items-center gap-4">
        <div class="fw-bold fs-5">
            Report count: <span class="badge bg-black">@Model.TotalCount</span>
        </div>

        <div class="fw-bold fs-5">
            By status:
            <ul class="list-unstyled d-flex flex-row flex-wrap gap-2 mb-0 mt-1">
                @foreach (var statusCount in Model.StatusCounts)
                {
                    <li>
                        <span class="badge bg-secondary">@statusCount.Key: @statusCount.Value</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <hr />
    <form asp-controller="Reports" asp-action="Index" method="get" class="align-content-center d-flex">
        <p class="align-content-center d-flex p-0 m-0 w-100">

            <label class="d-flex flex-row align-items-center me-2 w-100">
                <span class="me-2 fw-bold">Title:</span>
                <input type="text" asp-for="SearchString" class="form-control flex-grow-2" placeholder="Enter search" />
            </label>

            <label class="d-flex flex-row align-items-center me-2">
                <span class="me-2 fw-bold">From: </span>
                <input type="date" asp-for="DateFrom" class="form-control" />
            </label>
            <label class="d-flex flex-row align-items-center me-2">
                <span class="me-2 fw-bold">To:</span>
                <input type="date" asp-for="DateTo" class="form-control" />
            </label>

            <select asp-for="ReportStatus" asp-items="Model.Statuses" class="form-select me-2">
                <option value="">All</option>
            </select>

            <select asp-for="ImportanceRating" asp-items="Model.Ratings" class="form-select me-3">
                <option value="">All</option>
            </select>

            <input type="submit" value="Filter" class="btn btn-jade me-2" />
            <a asp-action="Index" class="btn btn-danger">Clear</a>
        </p>
    </form>
</div>

<div class="container card my-5 px-4 pt-4 pb-3 table-responsive">
    <table class="table table-striped table-hover table-bordered align-middle">
        <thead>
            <tr>
                <th class="text-center align-middle">
                    @Html.DisplayNameFor(model => model.Reports![0].Title)
                </th>
                <th class="text-center align-middle">
                    @Html.DisplayNameFor(model => model.Reports![0].Description)
                </th>
                <th class="text-center align-middle">
                    @Html.DisplayNameFor(model => model.Reports![0].Status)
                </th>
                <th class="text-center align-middle">
                    @Html.DisplayNameFor(model => model.Reports![0].ImportanceRating)
                </th>
                <th class="text-center align-middle">
                    Created By
                </th>
                <th class="text-center align-middle">
                    @Html.DisplayNameFor(model => model.Reports![0].ReportDate)
                </th>
                <th class="text-center align-middle">
                    Last Modified
                </th>
                <th class="text-center align-middle">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Reports!)
            {
                <tr>
                    <td class="text-center align-middle">
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td class="align-middle">
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td class="text-center align-middle">
                        @Html.DisplayFor(modelItem => item.Status)
                    </td>
                    <td class="text-center align-middle">
                        @Html.DisplayFor(modelItem => item.ImportanceRating)
                    </td>
                    <td class="text-center align-middle">
                        @(item.CreatedByUser?.UserName ?? "Unknown")
                    </td>
                    <td class="text-center align-middle">
                        @item.ReportDate.ToString("d")
                    </td>
                    <td class="text-center align-middle">
                        @if (item.LastModifiedByUser != null)
                        {
                            <div>@item.LastModifiedByUser.UserName</div>
                            <small class="text-muted">@item.LastModifiedAt?.ToString("g")</small>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="text-center align-middle text-nowrap">
                        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-cadet-blue">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        }
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-jade">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>