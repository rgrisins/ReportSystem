@model ReportSystem.Models.User

<div class="container card my-5 px-4 pt-4 pb-3">
    <h2 class="text-center bg-dark-subtle rounded-2 py-2 mb-2">Register</h2>
    <hr />
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" style="list-style: none; padding-left: 0;" class="text-danger border border-danger rounded p-2 mb-3"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Choose a username" />
            <span asp-validation-for="Username" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PasswordHash" class="form-label">Password</label>
            <input asp-for="PasswordHash" type="password" class="form-control" placeholder="Enter your password" />
            <span asp-validation-for="PasswordHash" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-cadet-blue w-100">Register</button>
    </form>
</div>