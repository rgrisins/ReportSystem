@model ReportSystem.Models.LoginRequest

<div class="container card my-5 px-4 pt-4 pb-3">
<h2 class="text-center bg-dark-subtle rounded-2 py-2 mb-2">Login</h2>
<hr />
<form asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger border border-danger rounded p-2 mb-3 list-unstyled"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-cadet-blue w-100">Login</button>
    </form>
</div>
