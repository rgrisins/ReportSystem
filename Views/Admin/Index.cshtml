@model ReportSystem.Models.UserViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Admin Panel";
}
<div class="container my-5">
    <div class="card">
        <div class="card-header">
            <h1 class="text-center bg-dark-subtle rounded-2 py-3 mb-0">
                <i class="fas fa-user-shield me-2"></i>Admin Panel
            </h1>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <a asp-action="Users" class="text-decoration-none">
                        <div class="card h-100 shadow-sm hover-card clickable-card">
                            <div class="card-body text-center">
                                <div class="mb-3">
                                    <i class="fas fa-users fa-4x text-info"></i>
                                </div>
                                <h3 class="card-title">Users</h3>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-md-6">
                    <a asp-action="RoleRequests" class="text-decoration-none">
                        <div class="card h-100 shadow-sm hover-card clickable-card">
                            <div class="card-body text-center">
                                <div class="mb-3">
                                    <i class="fas fa-user-tag fa-4x text-info"></i>
                                </div>
                                <h3 class="card-title">Role Requests</h3>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>